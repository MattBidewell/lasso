{
  "name": "lasso",
  "version": "0.1.0",
  "description": "TUI for managing Cloudflare Wrangler configs in monorepos",
  "type": "module",
  "bin": {
    "lasso": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target node --minify",
    "build:binary": "bun build src/index.tsx --compile --minify --outfile dist/lasso",
    "build:release": "bash scripts/build.sh",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.1.75",
    "@opentui/solid": "^0.1.77",
    "anser": "^1.4.10",
    "chokidar": "^3.6.0",
    "fast-glob": "^3.3.2",
    "solid-js": "^1.9.11",
    "strip-json-comments": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "wrangler",
    "tui",
    "cli",
    "monorepo"
  ],
  "license": "MIT"
}
